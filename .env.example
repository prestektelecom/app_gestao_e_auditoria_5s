# Copie para .env e preencha. Nunca coloque o .env no git.

# --- Obrigatórias ---------------------------------------------------------

# Conexão com o PostgreSQL 16 ou 17. O usuário deve ser o dono do banco
# (e ter CREATEROLE na primeira vez que rodar `npm run db:setup`).
DATABASE_URL=postgres://app_server:SENHA@localhost:5432/gestao5s

# Segredo para assinar links de fotos e uploads. No mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Pasta persistente onde ficam as fotos (evidências e manutenção).
# O processo do app precisa poder escrever nela. Inclua no backup do servidor.
STORAGE_DIR=./data/files

# Endereço público do app, sem barra no fim. Vai nos QR codes impressos
# e nos links dos e-mails de reset de senha.
PUBLIC_ORIGIN=https://5s.exemplo.com.br

# --- Opcionais ------------------------------------------------------------

# Porta HTTP do servidor (padrão 3000).
PORT=3000

# true se o app fica atrás de um proxy (nginx, Caddy) que envia X-Forwarded-For.
# Sem proxy, deixe false — senão o IP pode ser forjado e o limite de tentativas burlado.
TRUST_PROXY=false

# E-mail de reset de senha. Sem SMTP_HOST e SMTP_FROM, o app funciona,
# mas o "esqueci minha senha" avisa que o envio não está configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestão 5S <nao-responda@exemplo.com.br>"
# true para conexão TLS direta (porta 465); false para STARTTLS (porta 587).
SMTP_SECURE=false

# --- Só para a migração do Supabase (scripts) -----------------------------

# Banco de staging onde o backup do Supabase é restaurado (npm run db:migrate-from-supabase).
SOURCE_DATABASE_URL=postgres://postgres@localhost:5432/supabase_dump

# Projeto Supabase de origem, para copiar as fotos (npm run storage:import).
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_KEY=
